<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:viewBindingIgnore="true">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/lightning_details_toolbar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/signal_m3_toolbar_height"
        android:minHeight="@dimen/signal_m3_toolbar_height"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationIcon="@drawable/symbol_arrow_start_24"
        app:title="@string/LightningDetailsFragment__transaction_details"
        app:titleTextAppearance="@style/Signal.Text.TitleLarge" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:scrollIndicators="top|bottom">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <!-- Lightning bolt icon -->
            <ImageView
                android:id="@+id/lightning_details_icon"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginTop="16dp"
                android:src="@drawable/ic_lightning_bolt_24"
                android:scaleType="fitCenter"
                android:contentDescription="@string/LightningDetailsFragment__lightning_transaction"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <!-- Direction (Sent/Received) -->
            <TextView
                android:id="@+id/lightning_details_direction"
                style="@style/TextAppearance.Signal.Body2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:textColor="@color/signal_text_primary"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_icon"
                tools:text="Sent Lightning payment" />

            <!-- Amount in sats -->
            <TextView
                android:id="@+id/lightning_details_amount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:gravity="center"
                android:textSize="48sp"
                android:textColor="@color/core_green"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_direction"
                tools:text="+10,000 sat" />

            <!-- Description/Memo -->
            <TextView
                android:id="@+id/lightning_details_description"
                style="@style/Signal.Text.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="12dp"
                android:layout_marginEnd="16dp"
                android:background="@drawable/rounded_rectangle_tertiary"
                android:paddingStart="16dp"
                android:paddingTop="6dp"
                android:paddingEnd="16dp"
                android:paddingBottom="8dp"
                android:textAlignment="center"
                android:textColor="@color/signal_text_primary"
                android:visibility="gone"
                app:layout_constrainedWidth="true"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_amount"
                tools:text="Payment for coffee"
                tools:visibility="visible" />

            <!-- Divider -->
            <View
                android:id="@+id/lightning_details_divider"
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="32dp"
                android:background="@color/signal_background_secondary"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_description" />

            <!-- Status header -->
            <TextView
                android:id="@+id/lightning_details_status_header"
                style="@style/Signal.Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="@string/LightningDetailsFragment__status"
                android:textAlignment="viewStart"
                android:textColor="@color/signal_text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_divider" />

            <!-- Status value -->
            <TextView
                android:id="@+id/lightning_details_status"
                style="@style/Signal.Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:textAlignment="viewStart"
                android:textColor="@color/signal_text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_status_header"
                tools:text="Completed" />

            <!-- Date header -->
            <TextView
                android:id="@+id/lightning_details_date_header"
                style="@style/Signal.Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="@string/LightningDetailsFragment__date"
                android:textAlignment="viewStart"
                android:textColor="@color/signal_text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_status" />

            <!-- Date value -->
            <TextView
                android:id="@+id/lightning_details_date"
                style="@style/Signal.Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:textAlignment="viewStart"
                android:textColor="@color/signal_text_secondary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_date_header"
                tools:text="Jan 12, 2026 at 3:45 PM" />

            <!-- Fee header (only shown for outgoing) -->
            <TextView
                android:id="@+id/lightning_details_fee_header"
                style="@style/Signal.Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="@string/LightningDetailsFragment__network_fee"
                android:textAlignment="viewStart"
                android:textColor="@color/signal_text_primary"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_date"
                tools:visibility="visible" />

            <!-- Fee value -->
            <TextView
                android:id="@+id/lightning_details_fee"
                style="@style/Signal.Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:textAlignment="viewStart"
                android:textColor="@color/signal_text_secondary"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_fee_header"
                tools:text="2 sat"
                tools:visibility="visible" />

            <!-- Payment Hash header -->
            <TextView
                android:id="@+id/lightning_details_hash_header"
                style="@style/Signal.Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="@string/LightningDetailsFragment__payment_hash"
                android:textAlignment="viewStart"
                android:textColor="@color/signal_text_primary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_fee" />

            <!-- Payment Hash value -->
            <TextView
                android:id="@+id/lightning_details_hash"
                style="@style/Signal.Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:textAlignment="viewStart"
                android:textColor="@color/signal_text_secondary"
                android:fontFamily="monospace"
                android:textSize="12sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_hash_header"
                tools:text="a1b2c3d4e5f6..." />

            <!-- Preimage header -->
            <TextView
                android:id="@+id/lightning_details_preimage_header"
                style="@style/Signal.Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="16dp"
                android:text="@string/LightningDetailsFragment__preimage"
                android:textAlignment="viewStart"
                android:textColor="@color/signal_text_primary"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_hash"
                tools:visibility="visible" />

            <!-- Preimage value -->
            <TextView
                android:id="@+id/lightning_details_preimage"
                style="@style/Signal.Text.Body"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:textAlignment="viewStart"
                android:textColor="@color/signal_text_secondary"
                android:fontFamily="monospace"
                android:textSize="12sp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lightning_details_preimage_header"
                tools:text="b2c3d4e5f6a7..."
                tools:visibility="visible" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>

</LinearLayout>
